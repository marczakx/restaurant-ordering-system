{
  "realm": "restaurant",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "menu-editor",
        "description": "Can edit existing menu items"
      },
      {
        "name": "menu-creator",
        "description": "Can add new menu items"
      },
      {
        "name": "order-viewer",
        "description": "Can view all orders regardless of who placed them"
      },
      {
        "name": "admin",
        "description": "Administrator: can access the Keycloak admin console and other sensitive endpoints"
      },
      {
        "name": "superadmin",
        "description": "Super administrator: inherits the admin role and is allowed to access the Keycloak admin console"
      }
    ]
  },
  "clients": [
    {
      "clientId": "restaurant-client",
      "name": "Restaurant Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "restaurant-backend",
      "name": "Restaurant Backend",
      "description": "Confidential client used by the backend to introspect bearer tokens via the Keycloak token introspection endpoint (RFC 7662). Called by the nginx auth_request subrequest.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "restaurant-backend-secret",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@restaurant.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["menu-editor", "menu-creator"]
    },
    {
      "username": "editor",
      "enabled": true,
      "email": "editor@restaurant.local",
      "emailVerified": true,
      "firstName": "Menu",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "editor",
          "temporary": false
        }
      ],
      "realmRoles": ["menu-editor"]
    },
    {
      "username": "creator",
      "enabled": true,
      "email": "creator@restaurant.local",
      "emailVerified": true,
      "firstName": "Menu",
      "lastName": "Creator",
      "credentials": [
        {
          "type": "password",
          "value": "creator",
          "temporary": false
        }
      ],
      "realmRoles": ["menu-creator"]
    },
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@restaurant.local",
      "emailVerified": true,
      "firstName": "Order",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "realmRoles": ["order-viewer"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@restaurant.local",
      "emailVerified": true,
      "firstName": "Site",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "superadmin",
      "enabled": true,
      "email": "superadmin@restaurant.local",
      "emailVerified": true,
      "firstName": "Site",
      "lastName": "Superadmin",
      "credentials": [
        {
          "type": "password",
          "value": "superadmin",
          "temporary": false
        }
      ],
      "realmRoles": ["superadmin"]
    }
  ]
}
